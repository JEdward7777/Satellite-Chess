{
  "name": "satellite-chess",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build:client": "node scripts/build-client.mjs",
    "dev": "npm run build:client && wrangler dev",
    "deploy": "npm run build:client && wrangler deploy",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "plan": "node scripts/plan.mjs",
    "plan:check": "node scripts/plan.mjs --check",
    "plan:next": "node scripts/plan.mjs --next",
    "check": "npm run typecheck && npm test && npm run plan:check"
  },
  "dependencies": {
    "chess.js": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.18.8",
    "@cloudflare/workers-types": "^5.20260724.1",
    "esbuild": "^0.28.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "wrangler": "^4.114.0"
  }
}
