{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "satellite-chess",
  "main": "src/worker/index.ts",
  "compatibility_date": "2026-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [
      { "name": "GAME", "class_name": "GameDO" },
      { "name": "USER", "class_name": "UserDO" },
      { "name": "SURVEY", "class_name": "SurveyDO" }
    ]
  },
  // The Google OAuth client ID is not a secret — it travels in the redirect URL
  // on every sign-in. It lives here in plain `vars` so it is the same for every
  // developer; the matching `GOOGLE_CLIENT_SECRET` is a Worker secret set with
  // `wrangler secret put` and never committed. Consumed by `src/worker/auth.ts`
  // (stage 2.1, not yet written).
  "vars": {
    "GOOGLE_CLIENT_ID": "908007056119-hvrj0p5sa9k3rtcsbecqs7ehmf9rc82j.apps.googleusercontent.com"
  },
  // Session records (stage 2.2.1). The cookie carries an opaque token and
  // nothing else; everything about the session lives here, so signing out and
  // expiry are a delete and a TTL rather than a promise the token makes about
  // itself. KV rather than a Durable Object because this is read on every
  // authenticated request and a DO read would wake an object to answer it.
  //
  // Finished games (stage 8.4, decision 0042). One value per game, written once
  // by the game's own Durable Object just before it deletes itself, and read
  // only by the Worker when that object is gone. A namespace of its own rather
  // than a prefix inside SESSIONS, so that a session sweep can never touch a
  // game and a game can never be listed beside a session token.
  //
  // No `id` on purpose: wrangler 4 provisions the namespace on the first
  // `wrangler deploy` and records it on the Worker, and `wrangler dev` needs
  // none. Once it exists, its id may be pinned here like SESSIONS'.
  "kv_namespaces": [
    { "binding": "SESSIONS", "id": "5054a97ed81e4475ae7ef4b48d1b1fbc" },
    { "binding": "ARCHIVE", "id": "fe6b455ea33c415f983eee0921c64cdc" }
  ],
  // The free plan requires the SQLite storage backend. `new_classes` (the legacy
  // key-value backend) fails to deploy with error 10097.
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["GameDO", "UserDO"] },
    { "tag": "v2", "new_sqlite_classes": ["SurveyDO"] }
  ],
  "observability": { "enabled": true }
}
